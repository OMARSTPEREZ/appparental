{
  "expo": {
    "name": "Kibbo - Seguridad Familiar",
    "slug": "kibbo-seguridad-familiar",
    "scheme": "kibbo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kibbo.seguridadfamiliar",
      "infoPlist": {
        "NSCameraUsageDescription": "Kibbo requiere acceso a la camara para escanear el QR de vinculacion y funciones de seguridad.",
        "NSLocationWhenInUseUsageDescription": "Kibbo requiere acceso a la ubicacion para la supervision y geolocalizacion familiar.",
        "NSMicrophoneUsageDescription": "Kibbo requiere acceso al microfono para funciones de alerta de audio ambiental."
      }
    },
    "android": {
      "package": "com.kibbo.seguridadfamiliar",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "70d23a94-0283-45cc-949f-98de20e0b406"
      }
    },
    "owner": "omarsteperez",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Kibbo necesita la camara para escanear el QR de vinculacion."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kibbo necesita tu ubicacion para supervision familiar.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F172A"
        }
      ]
    ]
  }
}
